cmake_minimum_required(VERSION 3.24)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${repo}/cmake/runtime_mapping.cmake")
if(NOT DEFINED BUILD)
  message(FATAL_ERROR "Specify -DBUILD=<configured build>")
endif()
include("${BUILD}/test-runtime/inputs.cmake")
function(run out)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH
    --unset=LD_PRELOAD --unset=LD_AUDIT ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Runtime command failed (${status}): ${ARGN}\n${text}${err}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()
file(STRINGS "${BUILD}/test-runtime/targets.txt" binaries)
list(APPEND binaries ${EXTRA_BINARIES})
if(NOT binaries)
  message(FATAL_ERROR "No declared runtime executables")
endif()
set(roots "${BUILD};${runtime_prefixes}")
foreach(binary IN LISTS binaries)
  run(header "${runtime_readelf}" -l "${binary}")
  string(FIND "${header}" "[Requesting program interpreter: ${runtime_loader}]" interpreter)
  if(interpreter LESS 0)
    message(FATAL_ERROR "Executable does not select its pinned loader: ${binary}")
  endif()
  run(trace LD_TRACE_LOADED_OBJECTS=1 "${binary}")
  vectis_check_runtime_mapping("${trace}" "${runtime_sysroot}" "${roots}")
endforeach()
if(EXISTS "${BUILD}/tests/vectis_runtime_probe")
  run(probe "${BUILD}/tests/vectis_runtime_probe")
  string(STRIP "${probe}" probe)
  if(NOT probe STREQUAL "self-exec OK")
    message(FATAL_ERROR "Runtime self-exec failed: ${probe}")
  endif()
endif()
# Exercise the actual loader as well as synthetic mapping-parser fixtures. A
# missing runtime path must fail even if the host cache happens to find libc.
set(negative "${BUILD}/test-runtime/negative")
file(REMOVE_RECURSE "${negative}")
file(MAKE_DIRECTORY "${negative}")
set(probe_source "${repo}/tests/helpers/vectis_runtime_probe.c")
run(compiled "${runtime_compiler}" "${probe_source}" -o "${negative}/probe"
  "-Wl,--dynamic-linker=${runtime_loader}" -Wl,-z,nodefaultlib
  "-Wl,-rpath,${negative}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH
  --unset=LD_PRELOAD --unset=LD_AUDIT LD_TRACE_LOADED_OBJECTS=1 "${negative}/probe"
  OUTPUT_VARIABLE bad_trace ERROR_VARIABLE bad_error RESULT_VARIABLE bad_status)
file(WRITE "${negative}/trace.txt" "${bad_trace}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DTRACE_FILE=${negative}/trace.txt"
  "-DSYSROOT=${runtime_sysroot}" "-DROOTS=${roots}"
  -P "${repo}/cmake/runtime_mapping.cmake"
  RESULT_VARIABLE rejected OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rejected EQUAL 0)
  message(FATAL_ERROR "Missing-runtime executable escaped the mapping gate: ${bad_trace}")
endif()
if(runtime_exe_debug_flags MATCHES "fsanitize=")
  separate_arguments(exe_flags UNIX_COMMAND "${runtime_exe_debug_flags}")
  separate_arguments(shared_flags UNIX_COMMAND "${runtime_shared_debug_flags}")
  run(compiled "${runtime_compiler}" "${probe_source}" -fPIC -shared
    ${shared_flags} -Wl,-soname,libruntime-probe.so -o "${negative}/libruntime-probe.so")
  run(metadata "${runtime_readelf}" -d "${negative}/libruntime-probe.so")
  if(metadata MATCHES "libasan\\.so|libubsan\\.so")
    message(FATAL_ERROR "Shared consumer accidentally inherits sanitizer runtime: ${metadata}")
  endif()
  run(compiled "${runtime_compiler}" "${probe_source}" ${exe_flags}
    "-L${negative}" -Wl,--no-as-needed -lruntime-probe
    "-Wl,--dynamic-linker=${runtime_loader}" -Wl,--disable-new-dtags
    "-Wl,-rpath,${negative}:${runtime_sysroot}/lib:${runtime_sysroot}/usr/lib:${runtime_sysroot}/../lib64"
    -o "${negative}/probe")
  run(trace LD_TRACE_LOADED_OBJECTS=1 "${negative}/probe")
  vectis_check_runtime_mapping("${trace}" "${runtime_sysroot}" "${roots}")
  run(probe "${negative}/probe")
  string(STRIP "${probe}" probe)
  if(NOT probe STREQUAL "self-exec OK")
    message(FATAL_ERROR "Sanitized executable/shared consumer failed self-exec: ${probe}")
  endif()
endif()
file(REMOVE_RECURSE "${negative}")
file(GLOB shared_libraries "${BUILD}/libvectis.so*")
foreach(library IN LISTS shared_libraries)
  run(metadata "${runtime_readelf}" -d "${library}")
  string(FIND "${metadata}" "${runtime_sysroot}" embedded)
  if(NOT embedded LESS 0 OR metadata MATCHES "NODEFLIB")
    message(FATAL_ERROR "Installed library embeds development runtime policy: ${library}")
  endif()
endforeach()
if(NOT SDK AND runtime_configuration STREQUAL "Release" AND runtime_cli)
  run(header "${runtime_readelf}" -l "${BUILD}/vectis")
  run(metadata "${runtime_readelf}" -d "${BUILD}/vectis")
  if(header MATCHES "INTERP" OR metadata MATCHES "NEEDED")
    message(FATAL_ERROR "Release CLI is not static")
  endif()
elseif(NOT SDK AND NOT runtime_configuration STREQUAL "Release")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DVECTIS_BINARY_DIR=${BUILD}" "-DVECTIS_ROOT=${repo}"
    -P "${repo}/cmake/package_archive.cmake" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(status EQUAL 0 OR NOT err MATCHES "requires a Release build")
    message(FATAL_ERROR "Debug packaging was not rejected correctly: ${out}${err}")
  endif()
endif()
list(LENGTH binaries count)
message(STATUS "Runtime contract passed for ${count} executables")
