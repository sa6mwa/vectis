cmake_minimum_required(VERSION 3.24)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${BUILD}/test-runtime/inputs.cmake")
include("${repo}/cmake/runtime_mapping.cmake")
set(work "${BUILD}/runtime mapping")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/allowed" "${work}/foreign")
set(library "${work}/foreign/libforeign.so")
set(binary "${work}/allowed/probe")
set(source "${repo}/tests/helpers/vectis_runtime_probe.c")
function(checked out)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Runtime mapping fixture failed: ${ARGN}\n${text}${err}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()
function(reject trace roots)
  file(WRITE "${work}/trace.txt" "${trace}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DTRACE_FILE=${work}/trace.txt"
    "-DSYSROOT=${runtime_sysroot}" "-DROOTS=${roots}" -P "${repo}/cmake/runtime_mapping.cmake"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(status EQUAL 0)
    message(FATAL_ERROR "Mapping gate accepted forbidden mappings: ${trace}")
  endif()
endfunction()
foreach(named OFF ON)
  set(soname)
  if(named)
    set(soname -Wl,-soname,libforeign.so)
  endif()
  checked(out "${runtime_compiler}" "${source}" -shared -fPIC ${soname} -o "${library}")
  checked(out "${runtime_compiler}" "${source}" -Wl,--no-as-needed "${library}"
    "-Wl,--dynamic-linker=${runtime_loader}"
    "-Wl,-rpath,${runtime_sysroot}/lib:${runtime_sysroot}/usr/lib:${work}/foreign" -o "${binary}")
  checked(trace "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD
    --unset=LD_AUDIT LD_TRACE_LOADED_OBJECTS=1 "${binary}")
  string(FIND "${trace}" "${library}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Fixture did not actually load its foreign library: ${trace}")
  endif()
  reject("${trace}" "${work}/allowed")
  vectis_check_runtime_mapping("${trace}" "${runtime_sysroot}" "${work}/allowed;${work}/foreign")
  reject("${trace}unrecognized loader output\n" "${work}/allowed;${work}/foreign")
  reject("${trace}libmissing.so => not found\n" "${work}/allowed;${work}/foreign")
  string(REPLACE "${runtime_sysroot}/lib/libc.so.6" "${library}" wrong_libc "${trace}")
  reject("${wrong_libc}" "${work}/allowed;${work}/foreign")
endforeach()
file(REMOVE_RECURSE "${work}")
