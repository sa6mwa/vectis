cmake_minimum_required(VERSION 3.24)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(work "${BUILD}/runtime-reconfigure")
file(REMOVE_RECURSE "${work}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=CMAKE_TOOLCHAIN_FILE
  "${CMAKE_COMMAND}" -S "${repo}" -B "${work}/unpinned"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(status EQUAL 0 OR NOT err MATCHES "Linux builds require a pinned toolchain")
  message(FATAL_ERROR "Unpinned configure was not rejected: ${out}${err}")
endif()
set(configure "${CMAKE_COMMAND}" -S "${repo}/tests/runtime" -B "${work}/fixture"
  "-DCMAKE_TOOLCHAIN_FILE=${repo}/cmake/toolchains/x86_64-linux-gnu.cmake"
  "-DCMAKE_PROJECT_INCLUDE=${repo}/cmake/test_runtime.cmake")
function(checked)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Runtime fixture failed: ${ARGN}\n${out}${err}")
  endif()
endfunction()
checked(${configure} -DWITH_EXTRA=ON)
file(STRINGS "${work}/fixture/test-runtime/targets.txt" targets)
list(LENGTH targets count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Expected both runtime targets: ${targets}")
endif()
checked(${configure} -DWITH_EXTRA=OFF)
file(STRINGS "${work}/fixture/test-runtime/targets.txt" targets)
if(NOT targets STREQUAL "${work}/fixture/runtime_kept")
  message(FATAL_ERROR "Stale runtime target survived reconfiguration: ${targets}")
endif()
checked("${CMAKE_COMMAND}" --build "${work}/fixture")
checked("${CMAKE_COMMAND}" "-DBUILD=${work}/fixture" -DSDK=ON -P "${repo}/scripts/test_runtime_contract.cmake")
checked(${configure} -DWITH_EXTRA=OFF -DCMAKE_BUILD_TYPE=Release -DVECTIS_BUILD_BINARY=OFF)
checked("${CMAKE_COMMAND}" --build "${work}/fixture")
checked("${CMAKE_COMMAND}" "-DBUILD=${work}/fixture" -P "${repo}/scripts/test_runtime_contract.cmake")
execute_process(COMMAND ${configure} -DVECTIS_TARGET_ID=x86_64-linux-musl
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(status EQUAL 0 OR NOT err MATCHES "does not match")
  message(FATAL_ERROR "Wrong runtime toolchain identity was not rejected: ${out}${err}")
endif()
file(REMOVE_RECURSE "${work}")
