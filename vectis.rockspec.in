package = "vectis"
version = "@VECTIS_LUA_ROCK_VERSION@-1"

source = {
  url = "@VECTIS_LUA_SOURCE_URL@",
  dir = "@VECTIS_LUA_SOURCE_DIR@",
}

description = {
  summary = "Vectis Lua facade helpers",
  detailed = [[
Vectis Lua helpers for applications that run the Vectis facade surface from a
Lua 5.5 environment. Native dependency modules remain dependency-owned and must
be provided by the embedding Vectis binary or separately installed facades.
LQL uses the released liblql 0.4.0 native facade unchanged, including scoped
cleanup and protected callback ownership.
Stateful manual outbox renewal requires liblockdc 0.23.0 or later. Managed
PostgreSQL XA also requires the matching linked provider and Vectis native core.
Incremental app-owned collection writers, count retention and synchronous
compression conversion use the released liblockdc 0.24.0 surface unchanged.
  ]],
  homepage = "https://github.com/sa6mwa/vectis",
  license = "MIT",
}

dependencies = {}

build = {
  type = "builtin",
  modules = {
    ["curl"] = "lua/curl/init.lua",
    ["vectis"] = "lua/vectis.lua",
    ["vectis.auth"] = "lua/vectis/auth.lua",
    ["vectis.cai"] = "lua/vectis/cai.lua",
    ["vectis.cli"] = "lua/vectis/cli.lua",
    ["vectis.dsv"] = "lua/vectis/dsv.lua",
    ["vectis.http"] = "lua/vectis/http.lua",
    ["vectis.kore"] = "lua/vectis/kore.lua",
    ["vectis.supervisor"] = "lua/vectis/supervisor.lua",
    ["vectis.workflow"] = "lua/vectis/workflow.lua",
    ["vectis.storage"] = "lua/vectis/storage.lua",
    ["vectis.pg"] = "lua/vectis/pg.lua",
    ["vectis.sql"] = "lua/vectis/sql.lua",
    ["vectis.sqlite"] = "lua/vectis/sqlite.lua",
    ["vectis.pdf"] = "lua/vectis/pdf.lua",
    ["vectis.png"] = "lua/vectis/png.lua",
    ["vectis.compression"] = "lua/vectis/compression.lua",
    ["vectis.lockd"] = "lua/vectis/lockd.lua",
    ["vectis.log"] = "lua/vectis/log.lua",
    ["vectis.mqtt"] = "lua/vectis/mqtt.lua",
    ["vectis.rest"] = "lua/vectis/rest.lua",
    ["vectis.smtp"] = "lua/vectis/smtp.lua",
    ["vectis.status"] = "lua/vectis/status.lua",
    ["vectis.terminal"] = "lua/vectis/terminal.lua",
    ["vectis.version"] = "lua/vectis/version.lua",
    ["vectis.webdav"] = "lua/vectis/webdav.lua",
    ["vectis.xml"] = "lua/vectis/xml.lua",
    ["vectis.digest"] = "lua/vectis/digest.lua",
    ["vectis.buffer"] = "lua/vectis/buffer.lua",
  },
}
