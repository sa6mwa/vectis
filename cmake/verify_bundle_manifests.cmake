cmake_minimum_required(VERSION 3.24)
# Fast archive identity check. Normal installed consumer discovery separately
# invokes each provider's own complete payload/mode/hash validation.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../scripts/dependency-pins.tsv" pins)
foreach(pair IN ITEMS "cpkt|core" "cpktdb|db" "cpktmisc|misc")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 name)
  list(GET pair 1 group)
  set(manifest "${ROOT}/deps/${name}/share/cpkt/packages/${group}.json")
  if(NOT EXISTS "${manifest}" OR IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "Missing independent ${name} SDK manifest: ${manifest}")
  endif()
  file(READ "${manifest}" content)
  string(JSON actual_group GET "${content}" group)
  string(JSON actual_target GET "${content}" target_id)
  string(JSON actual_version GET "${content}" release_version)
  if(NOT actual_target STREQUAL TARGET_ID OR NOT actual_group STREQUAL group)
    message(FATAL_ERROR "SDK target/owner mismatch for ${name}: ${actual_target}/${actual_group} != ${TARGET_ID}/${group}")
  endif()
  set(expected_version "")
  foreach(pin IN LISTS pins)
    if(pin MATCHES "^sdk\t${name}\t([^\t]+)\t${TARGET_ID}\t")
      set(expected_version "${CMAKE_MATCH_1}")
      break()
    endif()
  endforeach()
  if(expected_version STREQUAL "" OR NOT actual_version STREQUAL expected_version)
    message(FATAL_ERROR "SDK version mismatch for ${name}: ${actual_version} != ${expected_version}")
  endif()
endforeach()
