set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
include("${CMAKE_CURRENT_LIST_DIR}/../vectis_owned_paths.cmake")
vectis_check_toolchain_cache()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CPKT_LIFECYCLE_SCRIPTS_DIR VECTIS_EXTERNAL_ROOT)
if(NOT CPKT_LIFECYCLE_SCRIPTS_DIR)
  get_filename_component(CPKT_LIFECYCLE_SCRIPTS_DIR "${CMAKE_CURRENT_LIST_DIR}/../../scripts" ABSOLUTE)
  set(CPKT_LIFECYCLE_SCRIPTS_DIR "${CPKT_LIFECYCLE_SCRIPTS_DIR}" CACHE PATH "Declared lifecycle helpers")
endif()
execute_process(COMMAND "${CPKT_LIFECYCLE_SCRIPTS_DIR}/cpkt-toolchains.sh" discover arm64-apple-darwin
  RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE failure)
if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
  message(FATAL_ERROR "Prepare approved osxcross and pinned MIG before configure: scripts/cpkt-toolchains.sh ensure arm64-apple-darwin. ${failure}")
endif()
foreach(key root prefix cc cxx ld ar ranlib strip nm otool mig)
  string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" match "${description}")
  if(NOT match)
    message(FATAL_ERROR "osxcross discovery omitted ${key}")
  endif()
  set(selected_${key} "${CMAKE_MATCH_2}")
endforeach()
set(CMAKE_C_COMPILER "${selected_cc}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${selected_cxx}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${selected_ld}" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "${selected_ar}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${selected_ranlib}" CACHE FILEPATH "" FORCE)
set(CMAKE_STRIP "${selected_strip}" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "${selected_nm}" CACHE FILEPATH "" FORCE)
get_filename_component(selected_bin "${selected_ld}" DIRECTORY)
set(CMAKE_INSTALL_NAME_TOOL "${selected_bin}/${selected_prefix}-install_name_tool" CACHE FILEPATH "" FORCE)
if(NOT EXISTS "${CMAKE_INSTALL_NAME_TOOL}")
  message(FATAL_ERROR "Prepared osxcross collection lacks target install_name_tool")
endif()
set(VECTIS_OTOOL "${selected_otool}" CACHE FILEPATH "" FORCE)
set(CMAKE_OTOOL "${selected_otool}" CACHE FILEPATH "" FORCE)
set(CPKT_OTOOL "${selected_otool}" CACHE FILEPATH "" FORCE)
set(_cai_otool "${selected_otool}" CACHE FILEPATH "" FORCE)
set(ENV{MIG} "${selected_mig}")
foreach(flags CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
  if(NOT "${${flags}}" MATCHES "--ld-path=")
    set(${flags} "\"--ld-path=${selected_ld}\" ${${flags}}" CACHE STRING "" FORCE)
  endif()
endforeach()
file(GLOB selected_sdks LIST_DIRECTORIES TRUE "${selected_root}/SDK/MacOSX*.sdk")
list(SORT selected_sdks COMPARE NATURAL ORDER DESCENDING)
if(NOT selected_sdks)
  message(FATAL_ERROR "approved osxcross SDK is missing")
endif()
list(GET selected_sdks 0 selected_sdk)
set(CMAKE_OSX_SYSROOT "${selected_sdk}" CACHE PATH "" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${selected_sdk}")
file(GLOB selected_prefixes LIST_DIRECTORIES TRUE "${VECTIS_EXTERNAL_ROOT}/*")
foreach(prefix IN LISTS selected_prefixes)
  if(EXISTS "${prefix}/lib/cmake")
    list(APPEND CMAKE_FIND_ROOT_PATH "${prefix}")
    list(APPEND CMAKE_PREFIX_PATH "${prefix}")
  endif()
endforeach()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(VECTIS_TARGET_ID arm64-apple-darwin CACHE STRING "" FORCE)
set(VECTIS_TARGET_ARCH arm64 CACHE STRING "" FORCE)
set(VECTIS_TARGET_OS darwin CACHE STRING "" FORCE)
set(VECTIS_TARGET_LIBC "" CACHE STRING "" FORCE)
