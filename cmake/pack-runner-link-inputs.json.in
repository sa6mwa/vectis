{
  "format": "vectis-pack-runner-link-inputs",
  "version": 1,
  "vectis_version": "@PROJECT_VERSION@",
  "target_id": "@VECTIS_TARGET_ID@",
  "runner_archive": "lib/vectis/pack/libvectis_pack_runner.a",
  "cmake_target": "vectis::pack_runner",
  "cmake_package": "lib/cmake/vectis/vectisConfig.cmake",
  "link_model": "installed-sdk-cmake",
  "payload_sections": [
    "__VECTIS,__pack_header",
    "__VECTIS,__pack_script",
    "__VECTIS,__pack_bundle",
    "__VECTIS,__pack_assets",
    "__VECTIS,__pack_manifest"
  ],
  "finalization_order": [
    "collect-and-hash-payloads",
    "compile-section-object",
    "link-unsigned-runner",
    "pre-sign-macho-fixups",
    "codesign-final-bytes",
    "verify-final-bytes"
  ]
}
