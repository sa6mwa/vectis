include_guard(GLOBAL)

function(vectis_require_project_root path)
  get_filename_component(own_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  file(REAL_PATH "${path}" requested_root)
  if(NOT requested_root STREQUAL own_root)
    message(FATAL_ERROR "Project root must identify this checkout: ${path}")
  endif()
endfunction()

# Validate declared mutable paths, including existing symlinks. Installed
# consumers do not include this build-only module.
function(vectis_require_owned_path path label)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "${label} must be an absolute owned path: ${path}")
  endif()
  get_filename_component(repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  # REAL_PATH alone does not resolve an intermediate symlink when the final
  # directory is absent. Resolve the closest existing ancestor first.
  set(ancestor "${path}")
  set(tail)
  while(NOT EXISTS "${ancestor}")
    if(IS_SYMLINK "${ancestor}")
      message(FATAL_ERROR "${label} has a dangling symlink: ${path}")
    endif()
    cmake_path(GET ancestor FILENAME name)
    list(PREPEND tail "${name}")
    cmake_path(GET ancestor PARENT_PATH ancestor)
  endwhile()
  file(REAL_PATH "${ancestor}" resolved)
  foreach(name IN LISTS tail)
    cmake_path(APPEND resolved "${name}")
  endforeach()
  foreach(root IN ITEMS "${repo}/build" "${repo}/.cache" ${ARGN})
    file(REAL_PATH "${root}" root)
    cmake_path(IS_PREFIX root "${resolved}" NORMALIZE owned)
    if(owned)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "${label} cannot borrow another checkout or an undeclared cache: ${path}")
endfunction()

function(vectis_check_toolchain_cache)
  if(DEFINED ENV{CPKT_TOOLCHAIN_CACHE} AND NOT "$ENV{CPKT_TOOLCHAIN_CACHE}" STREQUAL "")
    if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
      set(global "$ENV{XDG_CACHE_HOME}/cpkt/toolchains")
    else()
      set(global "$ENV{HOME}/.cache/cpkt/toolchains")
    endif()
    vectis_require_owned_path("$ENV{CPKT_TOOLCHAIN_CACHE}" CPKT_TOOLCHAIN_CACHE "${global}")
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  vectis_check_toolchain_cache()
  foreach(path IN LISTS VECTIS_OWNED_PATHS)
    vectis_require_owned_path("${path}" "Lifecycle output"
      "${CMAKE_CURRENT_LIST_DIR}/../dist")
  endforeach()
endif()
