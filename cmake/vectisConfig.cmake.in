@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies can overwrite PACKAGE_PREFIX_DIR with CMake before 3.30.
set(_vectis_package_prefix "${PACKAGE_PREFIX_DIR}")
file(GLOB _vectis_bundled_prefixes LIST_DIRECTORIES TRUE "${PACKAGE_PREFIX_DIR}/deps/*")
foreach(_vectis_prefix IN LISTS _vectis_bundled_prefixes)
  if(EXISTS "${_vectis_prefix}/lib/cmake")
    list(PREPEND CMAKE_PREFIX_PATH "${_vectis_prefix}")
    list(PREPEND CMAKE_FIND_ROOT_PATH "${_vectis_prefix}")
  endif()
endforeach()
find_dependency(CpktCore 0.6.1 CONFIG REQUIRED)
find_dependency(CpktPostgres CONFIG REQUIRED)
find_dependency(CpktSqlite CONFIG REQUIRED)
find_dependency(CpktPdf CONFIG REQUIRED)
find_dependency(CpktPng CONFIG REQUIRED)
find_dependency(CpktZstdFacade CONFIG REQUIRED)
find_dependency(CpktLz4Facade CONFIG REQUIRED)
find_dependency(CpktLzmaFacade CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(OpenSSL CONFIG REQUIRED)
find_dependency(ZLIB CONFIG REQUIRED)
find_dependency(nghttp2 CONFIG REQUIRED)
find_dependency(Libssh2 CONFIG REQUIRED)
find_dependency(CURL CONFIG REQUIRED)
find_dependency(CpktLuaRuntime CONFIG REQUIRED)
find_dependency(CpktAudio CONFIG REQUIRED)
find_dependency(CpktOpcUa CONFIG REQUIRED)
find_dependency(CpktSus CONFIG REQUIRED)
find_package(LibXml2 CONFIG REQUIRED)
find_package(pslog 0.13.0 CONFIG REQUIRED)
find_package(lonejson 0.46.0 CONFIG REQUIRED)
find_package(liblql 0.4.1 CONFIG REQUIRED)
find_package(cai CONFIG REQUIRED)
find_package(libmdf 0.23.0 CONFIG REQUIRED)
find_package(softline CONFIG REQUIRED)
find_package(lockdc 0.28.0 CONFIG REQUIRED)
find_dependency(lockdc_postgres 0.28.0 CONFIG REQUIRED COMPONENTS static shared)
set(PACKAGE_PREFIX_DIR "${_vectis_package_prefix}")
unset(_vectis_package_prefix)

if(TARGET cai::cai_static AND TARGET lonejson::lonejson_static)
  set_property(TARGET cai::cai_static PROPERTY
    INTERFACE_LINK_LIBRARIES "CURL::libcurl;Threads::Threads;OpenSSL::Crypto;lonejson::lonejson_static")
endif()

set(_vectis_dependency_link_dirs)
foreach(_vectis_dependency_target IN ITEMS
    lockdc::static
    lockdc::shared
    cpkt::opcua
    cpkt::opcua_shared
    cpkt::sus
    cpkt::sus_shared
    cpkt::audio
    cpkt::audio_shared
    cai::cai_static
    cai::cai_shared
    libmdf::mdf_static
    libmdf::mdf_shared
    softline::softline_static
    softline::softline
    pslog::pslog_static
    pslog::pslog_shared
    CURL::libcurl
    Libssh2::libssh2
    OpenSSL::SSL
    OpenSSL::Crypto
    lonejson::lonejson_static
    lonejson::openssl
    lonejson::oidc
    lonejson::lonejson
    liblql::lql_static
    liblql::lql_shared
    LibXml2::LibXml2
    nghttp2::nghttp2
    ZLIB::ZLIB
    cpkt::curl_shared
    cpkt::libssh2_shared
    cpkt::openssl_ssl_shared
    cpkt::openssl_crypto_shared
    cpkt::libxml2_shared
    cpkt::nghttp2_shared
    cpkt::zlib_shared)
  if(TARGET "${_vectis_dependency_target}")
    get_target_property(_vectis_dependency_location
      "${_vectis_dependency_target}" IMPORTED_LOCATION)
    if(NOT _vectis_dependency_location)
      get_target_property(_vectis_dependency_location
        "${_vectis_dependency_target}" IMPORTED_LOCATION_RELEASE)
    endif()
    if(_vectis_dependency_location)
      get_filename_component(_vectis_dependency_link_dir
        "${_vectis_dependency_location}" DIRECTORY)
      list(APPEND _vectis_dependency_link_dirs
        "${_vectis_dependency_link_dir}")
    endif()
  endif()
endforeach()
list(REMOVE_DUPLICATES _vectis_dependency_link_dirs)

if(NOT TARGET vectis::static AND EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.a")
  set(_vectis_static_links
    cpkt::pdf
    cpkt::png
    cpkt::zstd
    cpkt::lz4
    cpkt::lzma
    cpkt::sqlite
    cpkt::postgres
    lockdc::postgres_static
    lockdc::static
    cpkt::opcua
    cpkt::sus
    cpkt::audio
    cai::cai_static
    libmdf::mdf_static
    softline::softline_static
    pslog::pslog_static
    CURL::libcurl
    Libssh2::libssh2
    OpenSSL::SSL
    OpenSSL::Crypto
    lonejson::lonejson_static
    lonejson::openssl
    lonejson::oidc
    liblql::lql_static
    LibXml2::LibXml2
    nghttp2::nghttp2
    ZLIB::ZLIB
  )
  add_library(vectis::static STATIC IMPORTED)
  set_target_properties(vectis::static PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.a"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@;${_vectis_dependency_link_dirs}"
    INTERFACE_LINK_LIBRARIES "${_vectis_static_links}"
  )
endif()

if(NOT TARGET vectis::shared)
  set(_vectis_shared_links
    cpkt::pdf_shared
    cpkt::png_shared
    cpkt::zstd_shared
    cpkt::lz4_shared
    cpkt::lzma_shared
    cpkt::sqlite_shared
    cpkt::postgres_shared
    lockdc::postgres_shared
    lockdc::shared
    cpkt::opcua_shared
    cpkt::sus_shared
    cpkt::audio_shared
    cai::cai_shared
    libmdf::mdf_shared
    softline::softline
    pslog::pslog_shared
    cpkt::curl_shared
    cpkt::libssh2_shared
    cpkt::openssl_ssl_shared
    cpkt::openssl_crypto_shared
    lonejson::lonejson
    lonejson::openssl
    lonejson::oidc
    liblql::lql_shared
    cpkt::libxml2_shared
    cpkt::nghttp2_shared
    cpkt::zlib_shared
  )
  if(APPLE AND EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.dylib")
    add_library(vectis::shared SHARED IMPORTED)
    set_target_properties(vectis::shared PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.dylib"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
      INTERFACE_LINK_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@;${_vectis_dependency_link_dirs}"
      INTERFACE_LINK_LIBRARIES "${_vectis_shared_links}"
    )
  elseif(EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.so")
    add_library(vectis::shared SHARED IMPORTED)
    set_target_properties(vectis::shared PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvectis.so"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
      INTERFACE_LINK_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@;${_vectis_dependency_link_dirs}"
      INTERFACE_LINK_LIBRARIES "${_vectis_shared_links}"
    )
  endif()
endif()

if(NOT TARGET vectis::vectis)
  if(TARGET vectis::static)
    add_library(vectis::vectis ALIAS vectis::static)
  elseif(TARGET vectis::shared)
    add_library(vectis::vectis ALIAS vectis::shared)
  endif()
endif()

unset(_vectis_dependency_link_dir)
unset(_vectis_dependency_link_dirs)
unset(_vectis_dependency_location)
unset(_vectis_dependency_target)
