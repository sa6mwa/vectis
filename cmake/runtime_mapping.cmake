# Validate actual loader mappings against the declared runtime and SDK roots.
function(vectis_check_runtime_mapping trace sysroot roots)
  file(GLOB system_libraries "${sysroot}/lib/*.so*" "${sysroot}/usr/lib/*.so*" "${sysroot}/../lib64/*.so*")
  string(REPLACE "\n" ";" lines "${trace}")
  set(checked_libc FALSE)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^(.+) +\\(0x[0-9a-fA-F]+\\)$")
      message(FATAL_ERROR "Unrecognized runtime mapping: ${line}")
    endif()
    string(STRIP "${CMAKE_MATCH_1}" entry)
    if(entry STREQUAL "linux-vdso.so.1")
      continue()
    endif()
    if(entry MATCHES "^(.+) => (.+)$")
      set(name "${CMAKE_MATCH_1}")
      set(path "${CMAKE_MATCH_2}")
    else()
      set(path "${entry}")
      get_filename_component(name "${path}" NAME)
    endif()
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
      message(FATAL_ERROR "Nonexistent/nonabsolute runtime mapping: ${line}")
    endif()
    file(REAL_PATH "${path}" actual)
    set(known_system FALSE)
    set(accepted FALSE)
    foreach(candidate IN LISTS system_libraries)
      get_filename_component(candidate_name "${candidate}" NAME)
      if(candidate_name STREQUAL name)
        set(known_system TRUE)
        file(REAL_PATH "${candidate}" expected)
        if(actual STREQUAL expected)
          set(accepted TRUE)
        endif()
      endif()
    endforeach()
    if(NOT known_system)
      foreach(root IN LISTS roots)
        file(REAL_PATH "${root}" owned)
        cmake_path(IS_PREFIX owned "${actual}" NORMALIZE under_root)
        if(under_root AND NOT actual STREQUAL owned)
          set(accepted TRUE)
        endif()
      endforeach()
    endif()
    if(NOT accepted)
      message(FATAL_ERROR "Forbidden runtime mapping: ${name} => ${actual}")
    endif()
    if(name STREQUAL "libc.so.6")
      set(checked_libc TRUE)
    endif()
  endforeach()
  if(NOT checked_libc)
    message(FATAL_ERROR "Runtime mapping contains no pinned libc: ${trace}")
  endif()
endfunction()
if(DEFINED TRACE_FILE)
  file(READ "${TRACE_FILE}" trace)
  vectis_check_runtime_mapping("${trace}" "${SYSROOT}" "${ROOTS}")
endif()
