prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: vectis
Description: C SDK and runtime integration layer for pkt.systems services
Version: @PROJECT_VERSION@
Requires.private: cpkt-core >= 0.6.1 lockdc >= 0.28.0 lockdc-postgres >= 0.28.0 cpkt-postgres cpkt-png cpkt-zstd cpkt-lz4 cpkt-lzma cpkt-pdf cpkt-sqlite cpkt-opcua cpkt-sus cpkt-audio cai liblql >= 0.4.1 libmdf >= 0.23.0 softline pslog >= 0.13.0 libcurl libssh2 openssl lonejson >= 0.46.0 libxml-2.0 libnghttp2 zlib
Libs: -L${libdir} -lvectis
Libs.private: -pthread -ldl -lm
Cflags: -I${includedir}
