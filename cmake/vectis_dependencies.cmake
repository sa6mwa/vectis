# Independent installed SDKs. The TSV is acquisition data, not a build graph.
include("${CMAKE_CURRENT_LIST_DIR}/vectis_owned_paths.cmake")
vectis_require_owned_path("${VECTIS_EXTERNAL_ROOT}" VECTIS_EXTERNAL_ROOT)
if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
  set(vectis_global_dependency_cache "$ENV{XDG_CACHE_HOME}/cpkt/deps")
else()
  set(vectis_global_dependency_cache "$ENV{HOME}/.cache/cpkt/deps")
endif()
vectis_require_owned_path("${CPKT_DEPENDENCY_CACHE}" CPKT_DEPENDENCY_CACHE "${vectis_global_dependency_cache}")
set(vectis_dependency_manifest "${VECTIS_EXTERNAL_ROOT}/manifest.txt")
if(NOT EXISTS "${vectis_dependency_manifest}")
  message(FATAL_ERROR "Prepare dependencies first: scripts/deps.sh deps-${VECTIS_TARGET_ID}")
endif()
vectis_require_manifest(target_id "${VECTIS_TARGET_ID}")
file(STRINGS "${CMAKE_SOURCE_DIR}/scripts/dependency-pins.tsv" vectis_dependency_pins)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_SOURCE_DIR}/scripts/dependency-pins.tsv" "${vectis_dependency_manifest}")
set(vectis_dependency_prefixes)
set(vectis_external_include_dirs)
set(vectis_external_library_dirs)
foreach(pin IN LISTS vectis_dependency_pins)
  if(pin MATCHES "^#")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${pin}")
  list(GET fields 0 kind)
  list(GET fields 1 name)
  list(GET fields 2 version)
  list(GET fields 3 target)
  list(GET fields 4 digest)
  if(NOT target STREQUAL VECTIS_TARGET_ID AND NOT target STREQUAL "all"
      AND NOT (target STREQUAL "linux" AND CMAKE_SYSTEM_NAME STREQUAL "Linux"))
    continue()
  endif()
  string(REPLACE "-" "_" key "${name}")
  if(kind STREQUAL "lua")
    string(APPEND key "_lua")
  else()
    set(prefix "${VECTIS_EXTERNAL_ROOT}/${name}")
    vectis_require_owned_path("${prefix}" "${name} SDK prefix")
    if(NOT IS_DIRECTORY "${prefix}")
      message(FATAL_ERROR "Missing ${name} prefix; prepare scripts/deps.sh deps-${VECTIS_TARGET_ID}")
    endif()
    list(APPEND vectis_dependency_prefixes "${prefix}")
    list(APPEND vectis_external_include_dirs "${prefix}/include")
    if(EXISTS "${prefix}/include/libxml2")
      list(APPEND vectis_external_include_dirs "${prefix}/include/libxml2")
    endif()
    if(EXISTS "${prefix}/lib")
      list(APPEND vectis_external_library_dirs "${prefix}/lib")
    endif()
  endif()
  vectis_require_manifest("${key}_version" "${version}")
  vectis_require_manifest("${key}_sha256" "${digest}")
endforeach()
list(PREPEND CMAKE_PREFIX_PATH ${vectis_dependency_prefixes})
list(PREPEND CMAKE_FIND_ROOT_PATH ${vectis_dependency_prefixes})
find_package(CpktCore 0.6.1 EXACT CONFIG REQUIRED)
if(NOT CpktCore_TARGET_ID STREQUAL VECTIS_TARGET_ID)
  message(FATAL_ERROR "Selected core SDK target does not match Vectis")
endif()
