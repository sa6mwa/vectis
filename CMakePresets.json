{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VECTIS_BUILD_STATIC": "ON",
        "VECTIS_BUILD_SHARED": "OFF",
        "VECTIS_BUILD_TESTS": "ON",
        "VECTIS_BUILD_FUZZERS": "OFF",
        "VECTIS_ENABLE_COVERAGE": "OFF",
        "VECTIS_INSTALL": "ON",
        "VECTIS_DIST_DIR": "${sourceDir}/build/${presetName}/dist"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/host-debug"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/x86_64-linux-gnu",
        "VECTIS_DIST_DIR": "${sourceDir}/dist"
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-linux-musl.cmake",
      "cacheVariables": {
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/x86_64-linux-musl"
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/aarch64-linux-gnu"
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-musl.cmake",
      "cacheVariables": {
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/aarch64-linux-musl"
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/armhf-linux-gnu.cmake",
      "cacheVariables": {
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/armhf-linux-gnu"
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "x86_64-linux-gnu-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/armhf-linux-musl.cmake",
      "cacheVariables": {
        "VECTIS_EXTERNAL_ROOT": "${sourceDir}/.cache/deps/armhf-linux-musl"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "VECTIS_ENABLE_COVERAGE": "ON",
        "VECTIS_BUILD_FUZZERS": "OFF"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer",
        "VECTIS_BUILD_TESTS": "OFF",
        "VECTIS_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "x86_64-linux-gnu-release", "configurePreset": "x86_64-linux-gnu-release" },
    { "name": "x86_64-linux-musl-release", "configurePreset": "x86_64-linux-musl-release" },
    { "name": "aarch64-linux-gnu-release", "configurePreset": "aarch64-linux-gnu-release" },
    { "name": "aarch64-linux-musl-release", "configurePreset": "aarch64-linux-musl-release" },
    { "name": "armhf-linux-gnu-release", "configurePreset": "armhf-linux-gnu-release" },
    { "name": "armhf-linux-musl-release", "configurePreset": "armhf-linux-musl-release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true }
    }
  ]
}
