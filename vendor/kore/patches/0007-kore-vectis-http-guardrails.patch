+static int
+http_body_rate_below(u_int64_t received, u_int64_t elapsed, u_int64_t rate)
+{
+	u_int64_t		max, seconds, required;
+
+	if (elapsed < 1000 || rate == 0)
+		return (0);
+
+	seconds = elapsed / 1000;
+	max = ~((u_int64_t)0);
+	if (seconds > max / rate)
+		return (1);
+
+	required = seconds * rate;
+	return (received < required);
+}
