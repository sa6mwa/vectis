--- a/include/kore/http.h
+++ b/include/kore/http.h
@@ -353,7 +353,7 @@ struct http_media_type {
 
 extern size_t		http_body_max;
 extern u_int16_t	http_body_timeout;
-extern u_int16_t	http_header_max;
