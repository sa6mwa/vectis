diff --git a/src/config.c b/src/config.c
index 704a033..31bd040 100644
--- a/src/config.c
+++ b/src/config.c
@@ -1451,13 +1451,16 @@ configure_filemap_index(char *option)
 static int
 configure_http_header_max(char *option)
 {
+	u_int64_t	value;
 	int		err;
 
-	http_header_max = kore_strtonum(option, 10, 1, 65535, &err);
-	if (err != KORE_RESULT_OK) {
+	value = kore_strtonum64(option, 0, &err);
+	if (err != KORE_RESULT_OK || value == 0 ||
+	    value > (u_int64_t)SIZE_MAX) {
 		kore_log(LOG_ERR, "bad http_header_max value '%s'", option);
 		return (KORE_RESULT_ERROR);
 	}
 
+	http_header_max = (size_t)value;
 	return (KORE_RESULT_OK);
 }
