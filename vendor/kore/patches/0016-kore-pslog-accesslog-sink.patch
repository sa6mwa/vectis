+#if defined(KORE_USE_PSLOG)
+static void
+accesslog_pslog(struct http_request *req, const char *method,
+    const char *http_version, const char *client_ip)
+{
+	pslog_field	fields[10];
+	char		real_ip_buf[INET6_ADDRSTRLEN];
+	char		cid_buf[64];
+	const char	*real_ip;
+	const char	*cid;
+	size_t		count;
+
+	if (accesslog_logger == NULL)
+		return;
+
+	real_ip = NULL;
+	if (accesslog_real_ip_resolver != NULL) {
+		real_ip = accesslog_real_ip_resolver(req, client_ip,
+		    real_ip_buf, sizeof(real_ip_buf));
+	}
+	if (real_ip == NULL)
+		real_ip = client_ip;
+	cid = NULL;
+	if (accesslog_correlation_id_resolver != NULL)
+		cid = accesslog_correlation_id_resolver(req, cid_buf,
+		    sizeof(cid_buf));
+
+	count = 0;
+	fields[count++] = pslog_str("client_ip", client_ip);
+	fields[count++] = pslog_str("real_ip", real_ip);
+	fields[count++] = pslog_str("method", method);
+	fields[count++] = pslog_str("path", req->path);
+	fields[count++] = pslog_str("http_version", http_version);
+	fields[count++] = pslog_u64("status", (pslog_uint64)req->status);
+	fields[count++] = pslog_u64("bytes", (pslog_uint64)req->content_length);
+	fields[count++] = pslog_str("referer", req->referer != NULL ?
+	    req->referer : "-");
+	fields[count++] = pslog_str("user_agent", req->agent != NULL ?
+	    req->agent : "-");
+	if (cid != NULL && *cid != '\0')
+		fields[count++] = pslog_str("cid", cid);
+
+	pslog_fields(accesslog_logger, PSLOG_LEVEL_INFO, "http request",
+	    fields, count);
+}
+#endif
