diff --git a/src/ljson.c b/src/ljson.c
new file mode 100644
index 0000000000000000000000000000000000000000..df46afbb97f6aeee8db2624aadc559cab1ddd491
--- /dev/null
+++ b/src/ljson.c
@@ -0,0 +1,78 @@
+/*
+ * vectis lonejson helpers for Kore request bodies.
+ */
+
+#include "kore.h"
+#include "http.h"
+#include "ljson.h"
+
+struct kore_ljson_reader {
+	struct http_request	*req;
+};
+
+static lonejson_read_result
+kore_ljson_http_reader(void *user, unsigned char *buffer, size_t capacity)
+{
+	struct kore_ljson_reader	*reader = user;
+	lonejson_read_result		result;
+	ssize_t				ret;
+
+	memset(&result, 0, sizeof(result));
+
+	ret = http_body_read(reader->req, buffer, capacity);
+	if (ret < 0) {
+		result.error_code = errno != 0 ? errno : EIO;
+		return (result);
+	}
+
+	result.bytes_read = (size_t)ret;
+	result.eof = (ret == 0);
+	return (result);
+}
+
+lonejson_status
+kore_ljson_validate_request(struct http_request *req, lonejson_error *error)
+{
+	struct kore_ljson_reader	reader;
+
+	if (req == NULL) {
+		if (error != NULL) {
+			memset(error, 0, sizeof(*error));
+			error->code = LONEJSON_STATUS_INVALID_ARGUMENT;
+			kore_strlcpy(error->message, "request is required",
+			    sizeof(error->message));
+		}
+		return (LONEJSON_STATUS_INVALID_ARGUMENT);
+	}
+
+	if (!http_body_rewind(req))
+		return (LONEJSON_STATUS_IO_ERROR);
+
+	reader.req = req;
+	return lonejson_validate_reader(kore_ljson_http_reader, &reader, error);
+}
+
+lonejson_status
+kore_ljson_parse_request(struct http_request *req, const lonejson_map *map,
+    void *dst, const lonejson_parse_options *options, lonejson_error *error)
+{
+	struct kore_ljson_reader	reader;
+
+	if (req == NULL || map == NULL || dst == NULL) {
+		if (error != NULL) {
+			memset(error, 0, sizeof(*error));
+			error->code = LONEJSON_STATUS_INVALID_ARGUMENT;
+			kore_strlcpy(error->message,
+			    "request, map, and destination are required",
+			    sizeof(error->message));
+		}
+		return (LONEJSON_STATUS_INVALID_ARGUMENT);
+	}
+
+	if (!http_body_rewind(req))
+		return (LONEJSON_STATUS_IO_ERROR);
+
+	reader.req = req;
+	return lonejson_parse_reader(map, dst, kore_ljson_http_reader,
+	    &reader, options, error);
+}
