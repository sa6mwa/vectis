+static int
+acme_ljson_parse(const lonejson_map *map, void *dst, const u_int8_t *body,
+    size_t len, const char *what)
+{
+	lonejson_error		error;
+	lonejson_status		status;
+
+	memset(dst, 0, map->struct_size);
+	status = lonejson_parse_buffer(map, dst, body, len, NULL, &error);
+	if (status != LONEJSON_STATUS_OK) {
+		kore_log(LOG_NOTICE, "%s: lonejson parse failed at %zu:%zu (%s)",
+		    what, error.line, error.column, error.message);
+		lonejson_cleanup(map, dst);
+		return (KORE_RESULT_ERROR);
+	}
+
+	return (KORE_RESULT_OK);
