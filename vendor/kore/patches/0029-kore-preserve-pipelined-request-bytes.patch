@@ -1521,9 +1532,35 @@
 void
 http_start_recv(struct connection *c)
 {
+	size_t			len;
+	u_int8_t		*data;
+
 	c->http_start = kore_time_ms();
 	c->http_timeout = http_header_timeout * 1000;
+	data = c->http_pipeline;
+	len = c->http_pipeline_len;
+	c->http_pipeline = NULL;
+	c->http_pipeline_len = 0;
 	net_recv_reset(c, http_header_max, http_header_recv);
+	if (len > 0) {
+		memcpy(c->rnb->buf, data, len);
+		c->rnb->s_off = len;
+		kore_free(data);
+		if (!http_header_recv(c->rnb))
+			kore_connection_disconnect(c);
+	}
+}
+
+static void
+http_pipeline_save(struct connection *c, const void *data, size_t len)
+{
+	if (len == 0)
+		return;
+	if (c->http_pipeline != NULL)
+		fatal("%s: pipeline already saved", __func__);
+	c->http_pipeline = kore_malloc(len);
+	memcpy(c->http_pipeline, data, len);
+	c->http_pipeline_len = len;
 }
 
