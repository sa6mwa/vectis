diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -37,11 +37,11 @@ CFLAGS+=-D_FORTIFY_SOURCE=2
 CFLAGS+=-DPREFIX='"$(PREFIX)"' -fstack-protector-all
 
 ifneq ("$(KORE_BUNDLE_ROOT)", "")
