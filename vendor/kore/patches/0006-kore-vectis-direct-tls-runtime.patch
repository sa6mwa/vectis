+#if defined(KORE_VECTIS_DIRECT_TLS)
+static void
+worker_domain_direct_tls(struct kore_domain *dom)
+{
+	int		fd;
+	ssize_t		ret;
+	struct stat	st;
+	u_int8_t	*pem;
+	size_t		off;
+
+	if (dom->server->tls == 0 || dom->tls_ctx != NULL)
+		return;
+
+	if (dom->certfile == NULL)
+		fatalx("missing certfile for '%s'", dom->domain);
+	if (stat(dom->certfile, &st) == -1)
+		fatalx("'%s': %s", dom->certfile, errno_s);
+	if (st.st_size <= 0)
+		fatalx("'%s': empty certificate file", dom->certfile);
+	if ((fd = open(dom->certfile, O_RDONLY)) == -1)
+		fatalx("open(%s): %s", dom->certfile, errno_s);
+
+	pem = kore_malloc(st.st_size);
+	off = 0;
+	while (off < (size_t)st.st_size) {
+		ret = read(fd, pem + off, (size_t)st.st_size - off);
+		if (ret == -1 && errno == EINTR)
+			continue;
+		if (ret <= 0)
+			fatalx("read(%s): %s", dom->certfile, errno_s);
+		off += ret;
+	}
+	(void)close(fd);
+
+	kore_tls_domain_setup(dom, KORE_PEM_CERT_CHAIN, pem, off);
+	kore_free(pem);
+}
+#endif
