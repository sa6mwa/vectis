 static FILE	*fp = NULL;
+#if defined(KORE_USE_PSLOG)
+static pslog_logger	*kore_pslog_logger = NULL;
+#endif
+
+#if defined(KORE_USE_PSLOG)
+static pslog_level
+kore_pslog_level(int prio)
+{
+	switch (prio) {
+	case KORE_LOG_TRACE:
+		return (PSLOG_LEVEL_TRACE);
+	case LOG_DEBUG:
+		return (PSLOG_LEVEL_DEBUG);
+	case LOG_INFO:
+		return (PSLOG_LEVEL_INFO);
+	case LOG_NOTICE:
+		return (PSLOG_LEVEL_INFO);
+	case LOG_WARNING:
+		return (PSLOG_LEVEL_WARN);
+	case LOG_ERR:
+	case LOG_CRIT:
+	case LOG_ALERT:
+	case LOG_EMERG:
+		return (PSLOG_LEVEL_ERROR);
+	default:
+		return (PSLOG_LEVEL_INFO);
+	}
+}
+
+static void
+kore_pslog_emit(int prio, const char *proc, const char *msg)
+{
+	pslog_level	level;
+
+	if (kore_pslog_logger == NULL)
+		return;
+
+	level = kore_pslog_level(prio);
+	pslog(kore_pslog_logger, level, msg, "proc=%s prio=%d", proc, prio);
+}
+#endif
 
