 void
+kore_accesslog_set_levels(pslog_level success_level,
+    pslog_level client_error_level, pslog_level server_error_level,
+    const struct kore_accesslog_status_level_rule *status_levels,
+    size_t status_level_count)
+{
+	if (status_level_count > KORE_ACCESSLOG_MAX_STATUS_LEVEL_RULES)
+		status_level_count = KORE_ACCESSLOG_MAX_STATUS_LEVEL_RULES;
+
+	accesslog_success_level = success_level;
+	accesslog_client_error_level = client_error_level;
+	accesslog_server_error_level = server_error_level;
+	accesslog_status_level_count = status_level_count;
+	if (status_level_count > 0 && status_levels != NULL) {
+		memcpy(accesslog_status_levels, status_levels,
+		    sizeof(*status_levels) * status_level_count);
+	}
+}
+
+static pslog_level
+accesslog_pslog_level(u_int16_t status)
+{
+	size_t	idx;
+
+	for (idx = 0; idx < accesslog_status_level_count; idx++) {
+		if (accesslog_status_levels[idx].status == status)
+			return (accesslog_status_levels[idx].level);
+	}
+	if (status >= 500)
+		return (accesslog_server_error_level);
+	if (status >= 400)
+		return (accesslog_client_error_level);
+	return (accesslog_success_level);
+}
