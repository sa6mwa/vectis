@@ -220,6 +220,7 @@
 #define CONN_LOG_TLS_FAILURE	0x0020
 #define CONN_TLS_ALPN_ACME_SEEN	0x0040
 #define CONN_TLS_SNI_SEEN	0x0080
+#define CONN_VECTIS_STALL_SEEN	0x0100
 
 #define KORE_IDLE_TIMER_MAX	5000
 
diff --git a/src/connection.c b/src/connection.c
index a2bf7bb..0055f12 100644
--- a/src/connection.c
+++ b/src/connection.c
@@ -25,6 +25,16 @@
 #include "kore.h"
 #include "http.h"
 
+#if defined(KORE_VECTIS_AUTOBLOCK_HOOKS)
+#include "vectis_kore_hooks.h"
+#else
+#define vectis_kore_autoblock_accept(c) (1)
+#define vectis_kore_autoblock_tcp_stall(c) ((void)0)
+#define vectis_kore_autoblock_http_status(r, s) ((void)0)
+#define vectis_kore_autoblock_connection_status(c, s) ((void)0)
+#define vectis_kore_autoblock_tls_failure(c) ((void)0)
+#endif
+
 struct kore_pool		connection_pool;
 struct connection_list		connections;
 struct connection_list		disconnected;
@@ -129,6 +131,13 @@ kore_connection_accept(struct listener *listener, struct connection **out)
 		return (KORE_RESULT_ERROR);
 	}
 
+	if (!vectis_kore_autoblock_accept(c)) {
+		close(c->fd);
+		kore_pool_put(&connection_pool, c);
+		*out = NULL;
+		return (KORE_RESULT_OK);
+	}
+
 	if (!kore_connection_nonblock(c->fd, listener->family != AF_UNIX)) {
 		close(c->fd);
 		kore_pool_put(&connection_pool, c);
@@ -232,6 +241,20 @@ void
 kore_connection_disconnect(struct connection *c)
 {
 	if (c->state != CONN_STATE_DISCONNECTING) {
+#if !defined(KORE_NO_HTTP)
+		if (c->state == CONN_STATE_ESTABLISHED &&
+		    c->proto == CONN_PROTO_HTTP &&
+		    c->http_response_count == 0 &&
+		    !(c->flags & CONN_VECTIS_STALL_SEEN)) {
+			c->flags |= CONN_VECTIS_STALL_SEEN;
+			vectis_kore_autoblock_tcp_stall(c);
+		}
+#else
+		if (!(c->flags & CONN_VECTIS_STALL_SEEN)) {
+			c->flags |= CONN_VECTIS_STALL_SEEN;
+			vectis_kore_autoblock_tcp_stall(c);
+		}
+#endif
 		c->state = CONN_STATE_DISCONNECTING;
 		if (c->disconnect)
 			c->disconnect(c);
@@ -373,8 +396,21 @@ kore_connection_check_idletimer(u_int64_t now, struct connection *c)
 	else
 		d = 0;
 
-	if (d >= c->idle_timer.length)
+	if (d >= c->idle_timer.length) {
+#if !defined(KORE_NO_HTTP)
+		if (c->http_response_count == 0 &&
+		    !(c->flags & CONN_VECTIS_STALL_SEEN)) {
+			c->flags |= CONN_VECTIS_STALL_SEEN;
+			vectis_kore_autoblock_tcp_stall(c);
+		}
+#else
+		if (!(c->flags & CONN_VECTIS_STALL_SEEN)) {
+			c->flags |= CONN_VECTIS_STALL_SEEN;
+			vectis_kore_autoblock_tcp_stall(c);
+		}
+#endif
 		kore_connection_disconnect(c);
+	}
 }
 
