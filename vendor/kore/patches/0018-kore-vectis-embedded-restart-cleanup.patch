+			kore_log(LOG_NOTICE,
+			    "failed to detach worker shm segment: %s", errno_s);
+		}
+	}
+
+	accept_lock = NULL;
+	kore_workers = NULL;
+	shm_accept_key = -1;
+	worker_pgrp = 0;
+	worker_no_lock = 0;
+	accept_avail = 0;
+	worker_active_connections = 0;
+	memset(worker_no_accept, 0, sizeof(worker_no_accept));
+}
