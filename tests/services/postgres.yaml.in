apiVersion: v1
kind: Pod
metadata:
  name: @NAME@
spec:
  restartPolicy: Never
  securityContext: {runAsUser: 70, runAsGroup: 70}
  containers:
    - name: postgres
      image: docker.io/library/postgres:14.24-alpine3.24@sha256:7116ab7df71ef638eda416adbb92466b58a9da423f5476f2b830aae0a97b4fa5
      args: ["postgres", "-c", "max_prepared_transactions=20"]
      env:
        - {name: POSTGRES_USER, value: vectis}
        - {name: POSTGRES_DB, value: vectis}
        - {name: POSTGRES_PASSWORD, value: "@PASSWORD@"}
        - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
      ports:
        - {containerPort: 5432, hostPort: @PORT@, hostIP: 127.0.0.1}
      volumeMounts:
        - {name: data, mountPath: /var/lib/postgresql/data}
      livenessProbe:
        exec:
          command: ["pg_isready", "-h", "127.0.0.1", "-U", "vectis", "-d", "vectis"]
        periodSeconds: 1
        timeoutSeconds: 1
        failureThreshold: 30
  volumes:
    - name: data
      hostPath: {path: "@STATE@", type: Directory}
