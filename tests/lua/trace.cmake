cmake_minimum_required(VERSION 3.24)
file(MAKE_DIRECTORY "${WORK_DIR}")
set(script "${WORK_DIR}/trace.lua")
set(failure "${WORK_DIR}/failure.lua")
file(WRITE "${script}" [=[
if arg[1] == "-x" then
  assert(arg[2] == "tail")
  print("app:-x:tail")
  return
end
assert(type(arg[0]) == "string" and #arg[0] > 0 and arg[0] ~= "-x")
assert(arg[1] == "first" and arg[2] == "second")
local co = coroutine.create(assert(load("local n=1\nreturn n+1", "=coroutine-event")))
local ok, value = coroutine.resume(co)
assert(ok and value == 2)
do local obj = setmetatable({}, {__gc=assert(load("_G.finalized=true", "=gc-event"))}) end
collectgarbage("collect")
assert(finalized)
assert(assert(load("return 1", "=weird"..string.char(10,27).."name"))() == 1)
assert(assert(load("return "..string.rep(" ",1000).."1"))() == 1)
print("done:first:second")
]=])
file(WRITE "${failure}" "error('trace-failure')\n")
if(PACKED)
  foreach(name script failure)
    file(REMOVE "${WORK_DIR}/${name}-packed")
    execute_process(COMMAND "${VECTIS_BIN}" -a pack --script "${${name}}"
      --output "${WORK_DIR}/${name}-packed" RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Trace fixture packing failed: ${error}")
    endif()
    set(${name} "${WORK_DIR}/${name}-packed")
  endforeach()
endif()

function(run path traced expected)
  if(PACKED)
    set(command "${path}")
    if(traced)
      list(APPEND command --vectis -x)
    endif()
  else()
    set(command "${VECTIS_BIN}")
    if(traced)
      list(APPEND command -x)
    endif()
    list(APPEND command "${path}")
  endif()
  execute_process(COMMAND ${command} ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "Trace execution exit ${status}, expected ${expected}: ${err}")
  endif()
  if(traced)
    if(NOT err MATCHES "(^|\n)\\+ .*:[0-9]+")
      message(FATAL_ERROR "No source/line events: ${err}")
    endif()
    string(REPLACE "\n" ";" lines "${err}")
    foreach(line IN LISTS lines)
      if(line MATCHES "^\\+ ")
        string(LENGTH "${line}" length)
        if(length GREATER 205)
          message(FATAL_ERROR "Unbounded trace source (${length} bytes)")
        endif()
      endif()
    endforeach()
  elseif(err MATCHES "(^|\n)\\+ ")
    message(FATAL_ERROR "Tracing was enabled without request: ${err}")
  endif()
  string(STRIP "${out}" out)
  set(output "${out}" PARENT_SCOPE)
  set(error "${err}" PARENT_SCOPE)
endfunction()

run("${script}" FALSE 0 first second)
if(NOT output STREQUAL "done:first:second")
  message(FATAL_ERROR "Untraced stdout changed: ${output}")
endif()
run("${script}" TRUE 0 first second)
if(NOT output STREQUAL "done:first:second" OR
   NOT error MATCHES "coroutine-event:[0-9]+" OR
   NOT error MATCHES "gc-event:[0-9]+" OR
   NOT error MATCHES "weird[?][?]name:[0-9]+")
  message(FATAL_ERROR "Trace output/metadata changed: ${output}\n${error}")
endif()
run("${script}" FALSE 0 -x tail)
if(NOT output STREQUAL "app:-x:tail")
  message(FATAL_ERROR "Application -x argument was consumed")
endif()
run("${failure}" TRUE 1)
if(NOT error MATCHES "trace-failure")
  message(FATAL_ERROR "Traced script error was lost")
endif()
run("${failure}" FALSE 1)
if(NOT error MATCHES "trace-failure")
  message(FATAL_ERROR "Untraced script error was lost")
endif()
