file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
function(scenario binary script mode suffix)
  set(root "${WORK_DIR}/${suffix}")
  file(MAKE_DIRECTORY "${root}")
  set(memory_arg)
  set(deadline 20)
  if(MEMORY)
    set(memory_arg memory)
    set(deadline 120)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "VECTIS_MCP_CLIENT=${CMAKE_CURRENT_LIST_DIR}/mcp_failure_client.lua" "VECTIS_MCP_RUNNER=${VECTIS_BIN}"
    "VECTIS_WS_CLIENT=${WS_CLIENT}"
    "${HTTP_TEST}" "${binary}" "${script}" "${mode}" "${root}" ${memory_arg}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT ${deadline})
  if(NOT result EQUAL 0 OR NOT out MATCHES "Lua HTTP behavior ok")
    file(READ "${root}/stderr.log" log)
    message(FATAL_ERROR "Lua HTTP ${mode}/${suffix} failed: ${result}\n${out}${err}\n${log}")
  endif()
  if(MEMORY)
    file(GLOB logs "${root}/memory.*.log")
    list(LENGTH logs count)
    if(count LESS 3)
      message(FATAL_ERROR "Missing parent/worker memory evidence")
    endif()
    foreach(log IN LISTS logs)
      file(READ "${log}" text)
      if(NOT text MATCHES "ERROR SUMMARY: 0 errors")
        message(FATAL_ERROR "Memory failure in ${log}: ${text}")
      endif()
    endforeach()
  endif()
endfunction()
scenario("${VECTIS_BIN}" "${SCRIPT}" "${MODE}" normal)
if(MODE STREQUAL "workflow-direct")
  scenario("${VECTIS_BIN}" "${SCRIPT}" workflow-concurrent normal-concurrent)
elseif(MODE STREQUAL "mcp-direct")
  scenario("${VECTIS_BIN}" "${SCRIPT}" mcp-supervised normal-supervised)
elseif(MODE STREQUAL "websocket-enabled")
  scenario("${VECTIS_BIN}" "${SCRIPT}" websocket-disabled normal-disabled)
endif()
if(NOT APPLE AND NOT MEMORY)
  set(packed "${WORK_DIR}/packed")
  execute_process(COMMAND "${VECTIS_BIN}" -a pack --script "${SCRIPT}" --output "${packed}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Lua HTTP packing failed: ${out}${err}")
  endif()
  if(MODE STREQUAL "mcp-direct")
    scenario("${packed}" - mcp-supervised packed-run)
  else()
    scenario("${packed}" - "${MODE}" packed-run)
  endif()
  if(MODE STREQUAL "workflow-direct")
    scenario("${packed}" - workflow-concurrent packed-concurrent)
  elseif(MODE STREQUAL "websocket-enabled")
    scenario("${packed}" - websocket-disabled packed-disabled)
  endif()
endif()
