# Check actual compilation inputs and embedded provider bytes, not metadata alone.
file(READ "${COMPILATION_DB}" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count}-1")
foreach(provider pslog lql mdf)
  file(REAL_PATH "${${provider}_core}" expected)
  set(found FALSE)
  foreach(index RANGE 0 ${last})
    string(JSON source GET "${commands}" ${index} file)
    file(REAL_PATH "${source}" actual)
    if(actual STREQUAL expected)
      set(found TRUE)
    endif()
    if(actual MATCHES "/generated/(pslog|lql|mdf)/")
      message(FATAL_ERROR "Local upstream facade adaptation is still compiled: ${actual}")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Released ${provider} source was not compiled: ${expected}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${VECTIS_BIN}" -a source --all --output-dir "${WORK_DIR}/export" --force
  RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 10)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Source export failed: ${error}")
endif()
set(pslog_path "pslog/init.lua")
set(lql_path "lql/init.lua")
set(mdf_path "libmdf.lua")
foreach(provider pslog lql mdf)
  file(SHA256 "${${provider}_module}" expected)
  file(SHA256 "${WORK_DIR}/export/${${provider}_path}" actual)
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Embedded ${provider} differs from its released Lua module")
  endif()
endforeach()
