file(MAKE_DIRECTORY "${WORK_DIR}")
set(uncaught "${WORK_DIR}/uncaught.lua")
file(WRITE "${uncaught}" [[local v=require('vectis')
local app=assert(v.app.new({access_log=false,port=39099}))
assert(app:mcp({tools={{name='echo',schema_json='{}',callback=function() return '{}' end}}}))
error('expected top-level failure',0)
]])
execute_process(COMMAND "${VECTIS_BIN}" -a pack -s "${uncaught}" -o "${WORK_DIR}/uncaught-packed"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Uncaught fixture packing failed: ${out}${err}")
endif()
foreach(mode IN ITEMS normal packed)
  if(mode STREQUAL "normal")
    set(command "${VECTIS_BIN}" "${uncaught}")
  else()
    set(command "${WORK_DIR}/uncaught-packed")
  endif()
  execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 3)
  if(NOT result EQUAL 1 OR NOT err MATCHES "expected top-level failure")
    message(FATAL_ERROR "Uncaught ${mode} cleanup failed (${result}): ${out}${err}")
  endif()
endforeach()
set(SCRIPT "${CMAKE_CURRENT_LIST_DIR}/mcp_failure_server.lua")
set(MODE mcp-direct)
include("${CMAKE_CURRENT_LIST_DIR}/http_behavior.cmake")
