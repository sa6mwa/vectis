if(NOT DEFINED SCRIPT)
  set(SCRIPT "${VECTIS_SOURCE_DIR}/tests/lua/upgrade_seams.lua")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")
set(root "${WORK_DIR}/upgrade-seams-data")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(test_env "VECTIS_UPGRADE_TEST_ROOT=${root}" "XDG_STATE_HOME=${root}/state" "XDG_CONFIG_HOME=${root}/config")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${test_env} "${VECTIS_BIN}" "${SCRIPT}"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT out MATCHES "upgrade seam behavior ok")
  message(FATAL_ERROR "upgrade seams failed: ${out}\n${err}")
endif()
if(NOT APPLE)
  set(packed "${WORK_DIR}/upgrade-seams-packed")
  execute_process(COMMAND "${VECTIS_BIN}" -a pack --script "${SCRIPT}" --output "${packed}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "upgrade pack failed: ${out}\n${err}")
  endif()
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${test_env} "${packed}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT result EQUAL 0 OR NOT out MATCHES "upgrade seam behavior ok")
    message(FATAL_ERROR "packed upgrade seams failed: ${out}\n${err}")
  endif()
endif()
